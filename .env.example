# Azure OpenAI — required
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Bulk load — path(s) to document folder(s), comma-separated
# Output is written to a "_cobol_transformer_output" subfolder inside the first path listed.
DOCUMENTS_PATH=C:/path/to/your/documents

# Model settings
# MODEL_REASONING_EFFORT controls how many tokens the model spends reasoning
# before generating output.  Higher effort = better quality, slower, more tokens
# consumed from the output budget.  low | medium | high
MODEL_REASONING_EFFORT=medium

# Maximum output tokens per LLM call.  gpt-5-mini supports 128k output tokens
# (shared with reasoning).  Critical calls (code generation) override this with
# 32,000; this default applies to lower-stakes calls (summaries, clustering, etc).
# Raise to 16000+ if you see summaries cut off; lowering speeds up cheaper calls.
MODEL_MAX_TOKENS=8000

# Sentence-transformers / HuggingFace
# Set to 1 after the embedding model has been downloaded once.
# Prevents the library from checking the HF Hub on every startup,
# eliminating the "unauthenticated requests" warning.
HF_HUB_OFFLINE=1
TOKENIZERS_PARALLELISM=false

# Document processing
MAX_DOCUMENT_SIZE_MB=50
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
SUPPORTED_FORMATS=.py,.cobol,.cbl,.cic,.cpy,.mps,.src,.ct1,.jcv,.prv,.docx,.html,.xlsx,.xlsm,.xlsb,.txt
